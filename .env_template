U2_TIME_SERIES_PREDICTION_IMAGE=u2/time-series-prediction:latest

LOG_LEVEL=INFO

NOMINATIM_DOMAIN=nominatim.openstreetmap.org
NOMINATIM_USER_AGENT_NAME=u2-demo-time-series-prediction

PUBLIC_HOLIDAY_API_URL=https://date.nager.at/api/v3

WEATHER_HISTORICAL_API_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_FORECAST_API_URL=https://api.open-meteo.com/v1/forecast

CACHE_DIR=".cache"

OUTPUT_PREDICTION_PATH = "./output"
MODEL_PATH="./models"
MODEL_TRAINING_RESULT_LEADERBOARD_PATH = "u2/training_result_leaderboard.csv"
MODEL_METADATA_PATH = "u2/metadata.json"
