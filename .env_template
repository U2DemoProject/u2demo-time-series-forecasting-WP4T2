# Copy this file to `.env` and adjust as needed. All variables are optional;
# the application falls back to the defaults shown below when a variable is
# unset.

# ── Docker ────────────────────────────────────────────────────────────────────
U2DEMO_TIME_SERIES_FORECASTING_IMAGE=u2demo/time-series-forecasting:latest

# UID/GID of the host user running the container. Files written to bind-mounted
# volumes (data/, models/, output/) will be owned by this user on the host.
# Run `id -u` and `id -g` to get your values.
UID=1000
GID=1000

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Nominatim (reverse geocoding for holiday + weather features) ──────────────
# Calling Nominatim anonymously is against their TOS, so a user-agent is required.
NOMINATIM_DOMAIN=nominatim.openstreetmap.org
NOMINATIM_USER_AGENT_NAME=u2demo-time-series-forecasting

# ── Public holiday API (Nager.Date) ───────────────────────────────────────────
PUBLIC_HOLIDAY_API_URL=https://date.nager.at/api/v3

# ── Weather API (Open-Meteo) ──────────────────────────────────────────────────
WEATHER_HISTORICAL_API_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_FORECAST_API_URL=https://api.open-meteo.com/v1/forecast
